# Armazenamento persistente local ou montado como volume privado.
DATABASE_URL="file:../dev.db"

# Gere uma chave aleatoria com ao menos 32 caracteres; nunca a publique.
# Exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_ACCESS_TOKEN="substitua-por-uma-chave-aleatoria-com-no-minimo-32-caracteres"

# Opcional quando o Chromium empacotado pelo Puppeteer nao puder ser usado.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome"

# Em producao, a sessao deve ficar em volume persistente e privado.
# WWEBJS_AUTH_PATH="/var/lib/whatsapp-sender/session"
