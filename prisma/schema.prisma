datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       WorkspaceMember[]
  contacts    Contact[]
  groups      ContactGroup[]
  templates   Template[]
  snippets    Snippet[]
  schedules   ScheduledMessage[]
  analytics   ContactAnalytics[]
  campaigns   Campaign[]
  reportConfigs ReportConfig[]
  reportRecipients ReportRecipient[]
  settings    Settings[]
  usageEvents UsageEvent[]
  idempotencyRecords IdempotencyRecord[]
  consentAudits ContactConsentAudit[]
  subscription Subscription?
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces WorkspaceMember[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("OWNER")
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Plan {
  id                   String   @id
  name                 String
  monthlyMessageLimit  Int
  contactLimit         Int?
  activeCampaignLimit  Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  planId             String
  status             String    @default("TRIAL")
  provider           String?
  providerCustomerId String?
  providerSubId      String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])
}

model UsageEvent {
  id          String   @id @default(cuid())
  workspaceId String
  type        String
  quantity    Int      @default(1)
  metadata    String?
  occurredAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type, occurredAt])
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  state       String   @default("IN_PROGRESS")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([expiresAt])
}

model Contact {
  id        String   @id @default(cuid())
  workspaceId String @default("local")
  name      String
  phone     String
  tags      String?
  consentStatus String   @default("UNKNOWN") // UNKNOWN, OPTED_IN, OPTED_OUT
  consentAt DateTime?
  optedOutAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scheduledMessages ScheduledMessage[]
  groupMemberships ContactGroupMembership[]
  consentAudits ContactConsentAudit[]

  @@unique([workspaceId, phone])
  @@index([workspaceId])
}

model ContactConsentAudit {
  id             String   @id @default(cuid())
  workspaceId    String   @default("local")
  contactId      String?
  contactName    String
  phone          String
  previousStatus String
  newStatus      String
  source         String   // MANUAL, WHATSAPP, SYSTEM, IMPORT
  reason         String?
  matchedKeyword String?
  messageId      String?
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, phone, createdAt])
  @@index([contactId, createdAt])
}

model ContactGroup {
  id          String   @id @default(cuid())
  workspaceId String  @default("local")
  name        String
  description String?
  color       String   @default("slate")
  icon        String   @default("users")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships ContactGroupMembership[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ContactGroupMembership {
  contactId String
  groupId   String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group   ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([contactId, groupId])
  @@index([groupId])
}

model Template {
  id        String   @id @default(cuid())
  workspaceId String @default("local")
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  media     String?  // JSON string: { data, mimetype, filename }
  category  String?
  
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scheduledMessages ScheduledMessage[]

  @@index([workspaceId])
}

model Snippet {
  id        String   @id @default(cuid())
  workspaceId String @default("local")
  trigger   String   // ex: "/pix"
  content   String   // ex: "Chave PIX: ..."
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, trigger])
  @@index([workspaceId])
}


model ScheduledMessage {
  id           String   @id @default(cuid())
  workspaceId  String   @default("local")
  scheduledFor DateTime
  status       String   @default("PENDING") // PENDING, SENT, FAILED, MISSED

  contactName  String
  contactPhone String

  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Contact   Contact? @relation(fields: [contactId], references: [id])
  contactId String?

  batchId   String?  // UUID of the broadcast batch
  batchName String?  // Optional name for grouping

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, scheduledFor])
  @@index([status, scheduledFor])
  @@index([batchId, status])
  @@index([scheduledFor])
}

model ContactAnalytics {
  id          String   @id @default(cuid())
  phone       String
  workspaceId String   @default("local")
  sentCount   Int      @default(0)
  readCount   Int      @default(0)
  lastReadAt  DateTime?
  lastSentAt  DateTime?
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phone])
}

// ============================================
// CAMPAIGN & REPORT MODELS
// ============================================

model Campaign {
  id            String   @id @default(cuid())
  workspaceId   String   @default("local")
  name          String   // Ex: "Promo Sexta" ou "Campanha para 150 contatos"
  templateName  String?  // Nome do template usado
  
  // Timing
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  
  // Metrics (immediate)
  totalContacts Int
  sentCount     Int      @default(0)
  failedCount   Int      @default(0)
  
  // Engagement (updated by polling)
  readCount     Int      @default(0)
  responseCount Int      @default(0)
  
  // Report status
  immediateReportSentAt   DateTime?
  engagementReportSentAt  DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startedAt])
}

model ReportConfig {
  id                  String   @id
  workspaceId          String   @default("local")
  sendImmediate       Boolean  @default(true)
  sendEngagement      Boolean  @default(true)
  engagementDelayMins Int      @default(240) // 4 horas
  engagementTimeFixed String?  // Ex: "23:00"
  
  recipients          ReportRecipient[]
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  updatedAt           DateTime @updatedAt

  @@unique([workspaceId])
}

model ReportRecipient {
  id        String   @id @default(cuid())
  workspaceId String @default("local")
  name      String   // Nome do gestor
  phone     String   // WhatsApp (formato: 5511999999999)
  isActive  Boolean  @default(true)
  
  configId  String   @default("default")
  config    ReportConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@unique([workspaceId, phone])
}

model Settings {
  id          String   @id
  workspaceId String   @unique @default("local")
  defaultLink String?
  defaultCTA  String?
  optOutFooterId String  @default("reply_sair")
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
